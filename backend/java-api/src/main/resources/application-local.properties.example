# Server Port for Local Development
server.port=8081

# Database Configuration (Forwarded from Server MySQL via SSH Tunnel)
spring.datasource.url=jdbc:mysql://localhost:3307/ecommerce_db
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate settings for local development
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true

# Flyway Migration
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
